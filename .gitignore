# Local environment variables (secrets)
.dev.vars
.mcp.json
# Ignore all dotenv files by default so secrets never commit. The single
# exception is .env.production, which holds ONLY the Clerk publishable key
# (pk_…) — a public, browser-safe value Vite must inline into the build.
.env
.env.*
!.env.production

# Wrangler / Miniflare local emulator state (local D1 + R2 data, never commit)
.wrangler/

# Claude Code
.claude/
.codex/
.superpowers/

# Generated audit run artifacts
audit/current/

# Migration data (contains personal info)
data/migration/

# Generated QR plaque files (run npm run generate:qr to regenerate)
scripts/output/

# Generated stories (rebuilt from content/stories/*.md on every build)
data/generatedStories.ts

# Playwright test artifacts
test-results/
playwright-report/
.playwright-mcp/

# the collector prototype's build scratch and its output
.proto-dist/
collector-prototype.html

# Scratch output from the impeccable design skill
.impeccable/
