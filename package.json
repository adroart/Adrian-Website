{
  "name": "adrian-rasmussen-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5555",
    "dev:full": "npm run build && wrangler pages dev dist --port 5555 --ip 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "generate:stories": "tsx scripts/generate-stories.ts",
    "generate:qr": "tsx scripts/generate-ul-qr.ts",
    "crop:oracle": "tsx scripts/crop-oracle-images.ts",
    "rename:oracle": "tsx scripts/rename-oracle-images.ts",
    "keystatic:dev": "vite --port 5555",
    "test": "npx playwright test",
    "test:unit": "npx tsx --test --experimental-test-module-mocks tests/living-legacy.test.ts && npx tsx --test --experimental-test-module-mocks tests/artwork-package-recovery.test.ts && npx tsx --test --experimental-test-module-mocks tests/public-lineage-history.test.ts && npx tsx --test --experimental-test-module-mocks tests/artwork-registry-rollout.test.ts",
    "test:mobile": "npx playwright test --project='Mobile Chrome' --reporter=list",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "sitemap": "tsx scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/karla": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@keystatic/core": "^0.5.50",
    "@stripe/stripe-js": "^8.7.0",
    "astronomy-engine": "^2.1.19",
    "better-auth": "^1.6.18",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "stripe": "^20.3.1",
    "wavesurfer.js": "^7.12.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "gray-matter": "^4.0.3",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
